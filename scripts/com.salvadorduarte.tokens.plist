<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily token-stats refresh. Install (after the Tokens window is merged to main):
       mkdir -p ~/.salvadorduarte-tokens && cp scripts/refresh-tokens.sh ~/.salvadorduarte-tokens/
       sed "s|HOME_PLACEHOLDER|$HOME|g" scripts/com.salvadorduarte.tokens.plist > ~/Library/LaunchAgents/com.salvadorduarte.tokens.plist
       launchctl load ~/Library/LaunchAgents/com.salvadorduarte.tokens.plist
     launchd runs a missed job when the Mac wakes, so a closed laptop just catches up. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.salvadorduarte.tokens</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>HOME_PLACEHOLDER/.salvadorduarte-tokens/refresh-tokens.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>HOME_PLACEHOLDER/.salvadorduarte-tokens/refresh.log</string>
  <key>StandardErrorPath</key><string>HOME_PLACEHOLDER/.salvadorduarte-tokens/refresh.log</string>
</dict>
</plist>
